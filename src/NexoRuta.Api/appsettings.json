{
  "Geocoding": {
    "Geoapify": {
      "PermitirLlamadasReales": false
    },
    "Consumo": {
      "MaxSolicitudes24Horas": 500,
      "SolicitudesPorSegundo": 3,
      "SolicitudesPorMinutoUsuario": 10,
      "TimeoutSegundos": 8
    },
    "MapboxTemporal": {
      "Habilitado": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SesionesMoviles": {
    "VigenciaRenovacionDias": 30
  },
  "Jwt": {
    "Issuer": "NexoRuta.Api",
    "Audience": "NexoRuta.Web"
  },
  "AllowedHosts": "*",
  "PlatformInitialization": {
    "Enabled": false
  },
  "DatabaseInitialization": {
    "ApplyMigrations": false,
    "SeedData": false
  },
  "RoutingGeoapify": {
    "PermitirLlamadasReales": false,
    "MaxSolicitudesDiaGlobal": 1000,
    "MaxSolicitudesDiaOperador": 100,
    "MaxTramosCalculo": 51,
    "Gps": {
      "AntiguedadMaximaSegundos": 120,
      "PrecisionMaximaMetros": 100
    },
    "SolicitudesPorSegundo": 4,
    "TimeoutSegundos": 8
  }
}
