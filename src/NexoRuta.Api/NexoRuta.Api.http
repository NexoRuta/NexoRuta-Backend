@NexoRuta.Api_HostAddress = http://localhost:5041
# For Compose, use http://localhost:5000 as HostAddress.
@NexoRuta.Email = operator@example.test
@NexoRuta.Password = replace-with-a-local-test-password

GET {{NexoRuta.Api_HostAddress}}/health/ready
Accept: application/json

###

POST {{NexoRuta.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "{{NexoRuta.Email}}",
  "password": "{{NexoRuta.Password}}"
}

> {%
client.global.set("NexoRuta.Token", response.body.accessToken);
%}

###

GET {{NexoRuta.Api_HostAddress}}/api/usuarios/actual
Authorization: Bearer {{NexoRuta.Token}}
Accept: application/json

###

GET {{NexoRuta.Api_HostAddress}}/api/usuarios/actual/permisos
Authorization: Bearer {{NexoRuta.Token}}
Accept: application/json

###

GET {{NexoRuta.Api_HostAddress}}/api/operadores
Authorization: Bearer {{NexoRuta.Token}}
Accept: application/json

###

GET {{NexoRuta.Api_HostAddress}}/api/envios
Authorization: Bearer {{NexoRuta.Token}}
Accept: application/json
